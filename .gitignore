# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/

# Vite cache
.vite/
**/.vite/

# Environment (secrets); handoff Markdown is NOT matched by these rules
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDE (cache and local state)
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Caches and temp
.cache/
**/.cache/
*.tmp
.temp/
tmp/
out-tsc/
*.tsbuildinfo

# Coverage / tooling output
coverage/
.nyc_output/

# Replit / local runtime (if present under workspace)
.local/

# Backup archives and historical duplicate tree (paths stay on disk; Git skips them)
*.zip
**/*.zip
old/
